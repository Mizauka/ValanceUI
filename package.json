{
  "name": "valance-ui-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build:vue": "pnpm --filter @valance-ui/vue build",
    "build:theme": "pnpm --filter @valance-ui/vitepress-theme build",
    "build:demo": "pnpm --filter @valance-ui/demo build",
    "build:blog": "pnpm --filter @valance-ui/blog-template build",
    "build": "pnpm build:vue && pnpm build:theme && pnpm build:demo && pnpm build:blog",
    "dev:demo": "pnpm --filter @valance-ui/demo dev",
    "dev:blog": "pnpm --filter @valance-ui/blog-template dev",
    "typecheck": "pnpm --filter @valance-ui/vue typecheck && pnpm --filter @valance-ui/vitepress-theme typecheck && pnpm --filter @valance-ui/demo typecheck",
    "test": "pnpm --filter @valance-ui/vue test"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^17.4.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitepress": "^1.6.3",
    "vitest": "^3.1.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  }
}
